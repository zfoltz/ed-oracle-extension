{
  "manifest_version": 3,
  "name": "Ed Oracle",
  "version": "1.0.0",
  "description": "LLM-powered oracle over your Ed Discussion course: auto-syncs the board, answers questions with citations, keeps a history of past Q&As.",
  "permissions": ["storage", "alarms", "cookies", "sidePanel"],
  "host_permissions": ["https://*.edstem.org/*", "https://edstem.org/*"],
  "optional_host_permissions": ["http://*/*", "https://*/*"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["https://*.edstem.org/*", "https://edstem.org/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Ed Oracle"
  },  "options_page": "options.html",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
